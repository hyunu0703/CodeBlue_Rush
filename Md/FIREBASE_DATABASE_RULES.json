{
  "rules": {
    ".read": false,
    ".write": false,
    "scores": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists() && (!data.exists() || newData.child('score').val() >= data.child('score').val())",
        ".validate": "newData.hasChildren(['name', 'score'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
